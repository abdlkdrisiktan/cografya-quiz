 "narrative": {
  "northStar": "İznik Çini Atölyesi",
  "overview": "Her yer bir çinidir; oyuncu doğru bildikçe çini pişer (bisküvi, astar, sırlı), yanlış cevap çiniyi çatlatır ve tekrar turu onu onarır. Zemin baştan sona İznik kobaltıdır; yüzeyler sırlı beyaz levhalardır ve üstlerinde konunun sır rengiyle bir bant taşırlar. Harita turkuaz çerçevede ekranın en büyük nesnesidir. Enerji parlak ve doygundur, ama kırmızı sadece aktif olana aittir.",
  "keyCharacteristics": [
   "Kobalt zemin, süsleme sadece zeminde ve madalyonda.",
   "Sırlı beyaz levhalar, 6 px köşe, üstte sır bandı.",
   "Çini durumları ilerlemenin kendisidir.",
   "Tek yazı ailesi Rubik, gömülü.",
   "Elle çizilmiş 2.2 px SVG ikonlar."
  ],
  "rules": [
   {
    "name": "The Tek Kırmızı Rule",
    "body": "İznik kırmızısı ekrandaki tek aktif renktir: birincil buton ve haritadaki hedef.",
    "section": "colors"
   },
   {
    "name": "The Çatlak Mor Rule",
    "body": "Yanlış cevap ve çatlak çini her zaman mangan morudur.",
    "section": "colors"
   },
   {
    "name": "The Mürekkep Turkuaz Rule",
    "body": "Üzerinde küçük beyaz yazı olan turkuaz dolgu #0c7d7b'dir.",
    "section": "colors"
   },
   {
    "name": "The Tek Aile Rule",
    "body": "Bütün metin Rubik'tir; hiyerarşiyi boyut ve ağırlık taşır.",
    "section": "typography"
   },
   {
    "name": "The Başlık Üstü Etiket Yok Rule",
    "body": "Başlık üstüne kicker/eyebrow satırı konmaz.",
    "section": "typography"
   },
   {
    "name": "The Sır Bandı Rule",
    "body": "Levhanın kimliği üstteki iç bant ile verilir; kenar ya da yan şerit kullanılmaz.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do zemini her ekranda İznik kobaltı ve kafes deseniyle doldur.",
   "Do yeni konu grubuna bir sır rengi ver ve panoda çini ızgarasıyla göster.",
   "Do ilerlemeyi çini durumlarıyla anlat.",
   "Do haritayı turkuaz çerçevede en büyük nesne olarak tut.",
   "Do ikonları 24×24, 2.2 px çizgili SVG sembol olarak ekle."
  ],
  "donts": [
   "Don't kırmızıyı madalyon, yıldız, seri, bant ya da yanlış cevap için kullanma.",
   "Don't yanlış cevabı kırmızıyla gösterme.",
   "Don't başlıkların üstüne kicker/eyebrow satırı koyma.",
   "Don't emoji ya da Unicode glifini ikon yerine kullanma.",
   "Don't kalp simgesi kullanma.",
   "Don't harici font ya da ağ isteği ekleme."
  ]
 }
